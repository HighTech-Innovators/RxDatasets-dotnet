<Project>

  <PropertyGroup Condition="'$(CI)' != 'true'">
    <!-- This is to disable the creation of Lock.json files locally -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile> 
  </PropertyGroup>

  <PropertyGroup Condition="'$(CI)' == 'true'">
    <NuGetAudit>false</NuGetAudit>
    <!-- This is to disable the usage of Lock.json files in the pipeline -->
    <RestoreLockedMode>false</RestoreLockedMode>
  </PropertyGroup>

  <PropertyGroup>
    <WarnOnPackingNonPackableProject>false</WarnOnPackingNonPackableProject>
    <PackageLicenseExpression>CPAL-1.0</PackageLicenseExpression>
    <Copyright>HighTech Innovators © 2024</Copyright>
    <Authors>Bart de Boer,Subhi Hamidi,Teun van Zon</Authors>
    <Company>HighTech Innovators</Company>
    <Description>A set of libraries that allow the development of Reactive Dataset-servers, using protobuf files a backing storage. Inspired by Netflix Hollow.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <!-- Version properties - set by CI pipeline via -p:VERSION parameter -->
    <!-- InformationalVersion uses the semantic version (without commit metadata) -->
    <!-- Extract version before any '+' metadata suffix (git-flow-version adds commit hash) -->
    <_VersionSemver Condition="'$(VERSION)' != ''">$([System.Text.RegularExpressions.Regex]::Replace($(VERSION), '\+.*$', ''))</_VersionSemver>
    <InformationalVersion Condition="'$(_VersionSemver)' != ''">$(_VersionSemver)</InformationalVersion>
    <!-- Prevent SDK from appending git commit hash to InformationalVersion -->
    <IncludeSourceRevisionInInformationalVersion Condition="'$(VERSION)' != ''">false</IncludeSourceRevisionInInformationalVersion>
    <!-- AssemblyVersion and FileVersion must be numeric only (major.minor.patch.revision) -->
    <!-- Extract numeric part before any pre-release identifier (dash) -->
    <_VersionNumericPart Condition="'$(_VersionSemver)' != ''">$([System.Text.RegularExpressions.Regex]::Match($(_VersionSemver), '^\d+(\.\d+)?(\.\d+)?(\.\d+)?').Value)</_VersionNumericPart>
    <FileVersion Condition="'$(_VersionNumericPart)' != ''">$(_VersionNumericPart)</FileVersion>
    <AssemblyVersion Condition="'$(_VersionNumericPart)' != ''">$(_VersionNumericPart)</AssemblyVersion>
  </PropertyGroup>
  
  <PropertyGroup>
    <!-- Enable PDB embedding -->
    <DebugType>embedded</DebugType>
    <EmbedAllSources>true</EmbedAllSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(SolutionDir)/README.md" Pack="true" PackagePath="/"/>
    <None Include="$(SolutionDir)/icon.png" Pack="true" PackagePath="/"/>
  </ItemGroup>

</Project>
