<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>HighTechInnovators.RxDatasets</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RxDatasets.Tests" />
    <InternalsVisibleTo Include="RxDatasets.StorageTests" />
    <InternalsVisibleTo Include="StreamingBenchmark" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Models\Config\**" />
    <EmbeddedResource Remove="Models\Config\**" />
    <None Remove="Models\Config\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Models\Legacy-Entities.proto" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.ProtoBuf" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="System.Reactive" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Grpc.Core.Api" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- Iconfig.GetValue !?! -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RxDatasets.Abstractions\RxDatasets.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Models\Legacy-Entities.proto" Access="Private" GrpcServices="None" />
    <Protobuf Include="Models\DatasetEntities.proto" GrpcServices="None" Access="Private" />
  </ItemGroup>

</Project>
