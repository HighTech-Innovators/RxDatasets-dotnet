{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "Dto": {
    "CustomRootFolder": ""
  },
  "Cleanup": {
    "MinimumSnapshotsToKeep": 2,
    "MinimumAgeToLiveInMinutes": 120
  },
  "SnapshotCreation": {
    "SnapshotInterval": 5
  },
  "AzStorage": {
    "ConnectionString": ""
  },
  "MinioS3": {
    "AccessKey": "ROOTUSER",
    "SecretKey": "MINIOPASSWORD",
    "ServiceURL": "localhost:9000",
    "BucketName": "dto-server"
  },
  "OpenTelemetry": {
    "Endpoint": "",
    "http": "//localhost:4317/"
  },
  "Serilog": {
    "MinimumLevel": "Debug",
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "dtoserver-demodto-v1"
    }
  }
}
