<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ProtoScope</RootNamespace>
    <AssemblyName>dtoscope</AssemblyName>
    
    <!-- NuGet Package Configuration -->
    <PackageId>HighTechInnovators.RxDatasets.DtoScope</PackageId>
    <Title>DtoScope</Title>
    <PackageDescription>CLI tool for inspecting RxDatasets proto files and converting them to YAML format</PackageDescription>
    <PackageProjectUrl>https://github.com/hightech-innovators/RxDatasets-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hightech-innovators/RxDatasets-dotnet</RepositoryUrl>
    
    <!-- dotnet tool Configuration -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dtoscope</ToolCommandName>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile></PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/RxDatasets/RxDatasets.csproj" />
    <PackageReference Include="YamlDotNet" />
    <None Include="../../icon.png" Pack="true" PackagePath="/"/>
  </ItemGroup>

</Project>
